{
  "buildCommand": "npm run build && cd backend && npm install && npx prisma generate && npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "backend/dist/**,backend/node_modules/.prisma/**,backend/prisma/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" }
  ]
}
