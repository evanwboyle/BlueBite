# Database (Supabase Postgres)
DATABASE_URL=
DIRECT_URL=

# Server
PORT=3000
SESSION_SECRET=bluebite-dev-secret
CORS_ORIGIN=http://localhost:5173
SERVER_BASE_URL=http://localhost:3000
NODE_ENV=development

# Image uploads (Supabase Storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Sheets order sync (optional)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=

# ─── Payments (Clover) ────────────────────────────────────────────────────
# See documentation/CLOVER_PAYMENTS.md for full setup + sandbox/simulator instructions.

# "mock" (default) - in-process simulator, zero Clover account needed.
# "clover"         - real Remote Pay Cloud integration, requires the vars below.
PAYMENT_PROVIDER=mock

# Only used by PAYMENT_PROVIDER=mock:
#   MOCK_PAYMENT_OUTCOME: succeed (default) | fail | manual
#   MOCK_PAYMENT_DELAY_MS: delay before succeed/fail resolves (default 3000)
MOCK_PAYMENT_OUTCOME=succeed
MOCK_PAYMENT_DELAY_MS=3000

# Enables POST /api/orders/:orderId/payment/simulate (admin-only, mock provider only)
# to force a "manual"-outcome mock payment to resolve on demand.
PAYMENTS_DEBUG_MODE=false

# Admin escape hatch (POST /api/orders/:orderId/payment/bypass) - set to
# "false" to disable entirely, e.g. in a production environment that should
# never release an order without a confirmed device payment.
PAYMENT_BYPASS_ENABLED=true

# Only used by PAYMENT_PROVIDER=clover:
CLOVER_MERCHANT_ID=
CLOVER_DEVICE_ID=
CLOVER_ACCESS_TOKEN=
CLOVER_ENVIRONMENT=sandbox
# CLOVER_SERVER_URL=              # overrides the sandbox/production default above
CLOVER_APP_ID=com.bluebite.pos:1.0.0
CLOVER_FRIENDLY_ID=BlueBite POS
CLOVER_FORCE_CONNECT=false
CLOVER_CONNECT_TIMEOUT_MS=20000
