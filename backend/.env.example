# Database (Supabase Postgres)
DATABASE_URL=
DIRECT_URL=

# Server
PORT=3000
SESSION_SECRET=bluebite-dev-secret
CORS_ORIGIN=http://localhost:5173
SERVER_BASE_URL=http://localhost:3000
NODE_ENV=development

# Image uploads (Supabase Storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Sheets order sync (optional with STORE=postgres, required with STORE=sheets)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=

# Where data lives. "postgres" (default) uses Prisma/Supabase; "sheets" makes the Google Sheet the
# system of record for the Benjamin Franklin buttery (see documentation/SHEETS_BACKEND.md).
# STORE=sheets
# Google accounts (comma-separated) allowed to edit the admin-only tabs/columns. Unset = nothing is protected.
# SHEETS_ADMIN_EMAILS=admin1@yale.edu,admin2@yale.edu
# Shared secret the Apps Script onEdit trigger sends to POST /api/sheets/webhook (unset disables the webhook).
# SHEETS_WEBHOOK_SECRET=

# ─── Payments (Clover) ────────────────────────────────────────────────────
# See documentation/CLOVER_PAYMENTS.md for full setup + sandbox/simulator instructions.

# "mock" (default) - in-process simulator, zero Clover account needed.
# "clover"         - real Remote Pay Cloud integration (persistent WebSocket), requires the vars below.
# "clover-rest"    - REST Pay Display API over HTTPS (serverless-friendly): needs CLOVER_ACCESS_TOKEN,
#                    CLOVER_DEVICE_SERIAL, optional CLOVER_POS_ID, CLOVER_PAY_TIMEOUT_SECONDS (default 55).
PAYMENT_PROVIDER=mock

# Only used by PAYMENT_PROVIDER=mock:
#   MOCK_PAYMENT_OUTCOME: succeed (default) | fail | manual
#   MOCK_PAYMENT_DELAY_MS: delay before succeed/fail resolves (default 3000)
MOCK_PAYMENT_OUTCOME=succeed
MOCK_PAYMENT_DELAY_MS=3000

# Enables POST /api/orders/:orderId/payment/simulate (admin-only, mock provider only)
# to force a "manual"-outcome mock payment to resolve on demand.
PAYMENTS_DEBUG_MODE=false

# Admin escape hatch (POST /api/orders/:orderId/payment/bypass) - set to
# "false" to disable entirely, e.g. in a production environment that should
# never release an order without a confirmed device payment.
PAYMENT_BYPASS_ENABLED=true

# Only used by PAYMENT_PROVIDER=clover:
CLOVER_MERCHANT_ID=
CLOVER_DEVICE_ID=
CLOVER_ACCESS_TOKEN=
CLOVER_ENVIRONMENT=sandbox
# CLOVER_SERVER_URL=              # overrides the sandbox/production default above
CLOVER_APP_ID=com.bluebite.pos:1.0.0
CLOVER_FRIENDLY_ID=BlueBite POS
CLOVER_FORCE_CONNECT=false
CLOVER_CONNECT_TIMEOUT_MS=20000

# ─── Realtime push (Ably) ─────────────────────────────────────────────────
# With a key, order/menu/payment events are also published to Ably (needed on serverless, which
# cannot hold SSE connections). Build the frontend with VITE_REALTIME=ably to subscribe.
# Without it the SSE stream at /api/events is used.
ABLY_API_KEY=

# ─── Serverless / Vercel ──────────────────────────────────────────────────
# Auth is a stateless JWT cookie. Falls back to SESSION_SECRET; required in production.
JWT_SECRET=
# Upstash Redis REST credentials (https, not the redis:// URL). When set, the sheet mirror and payment
# attempts are shared through Redis and there is no in-process poll timer.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Where CAS login redirects after success (defaults to CORS_ORIGIN, then http://localhost:5173).
# FRONTEND_URL=
